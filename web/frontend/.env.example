# Frontend Vite configuration

# API v2 (Remnawave Admin)
VITE_API_V2_URL=http://localhost:8081
VITE_API_URL=http://localhost:8081

# Camera Monitor API (FastAPI)
VITE_CAMERA_API_URL=http://localhost:8002

# WebSocket URL (for real-time updates)
VITE_WS_URL=ws://localhost:8081

# Telegram bot username for login (optional)
VITE_TELEGRAM_BOT_USERNAME=

# Secret path for backend (optional)
VITE_SECRET_PATH=

# App title
VITE_APP_NAME="Remnawave Admin"
