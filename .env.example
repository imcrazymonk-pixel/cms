# ============================================
# База данных (PostgreSQL) — обязательные
# ============================================
DB_DRIVER=pgsql
DB_HOST=db
DB_PORT=5432
DB_NAME=cms
DB_USER=cms
DB_PASS=change_this_password

# ============================================
# Приложение
# ============================================
APP_DEBUG=true
SITE_NAME=HexaVeil VPN
ADMIN_EMAIL=admin@example.com

# ============================================
# Безопасность (JWT / шифрование)
# ============================================
# Ключ шифрования для секретов (AES-256-CBC, 64 hex-символа).
# Используется PHP (core/Crypto.php) и FastAPI (web/backend) — должны совпадать.
APP_ENCRYPTION_KEY=your_64_hex_char_encryption_key

# JWT secret. Если пусто — используется APP_ENCRYPTION_KEY (поведение PHP).
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL=86400

# ============================================
# API-сервер (FastAPI)
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# ============================================
# Логирование
# ============================================
LOG_DIR=/app/logs
WEB_LOG_LEVEL=INFO
# Максимальный размер загружаемого файла (байт)
MAX_UPLOAD_SIZE=67108864

# ============================================
# Конфигурация Bedolaga Bot (интеграция)
# ============================================
# Bedolaga Bot Web API (прокси для /api/bedolaga/*)
# BEDOLAGA_API_URL=http://your-bot-domain.com
# BEDOLAGA_API_TOKEN=your_bot_web_api_token

# ============================================
# База данных бота (read-only — каталог тарифов)
# ============================================
# BOT_DB_HOST=144.31.156.172
# BOT_DB_PORT=5434
# BOT_DB_NAME=remnawave_bot
# BOT_DB_USER=cms_ro
# BOT_DB_PASS=change_this_readonly_password

# ============================================
# Финансы: Platega
# ============================================
# Значения ниже переопределяют настройки из БД (приоритет env > БД).
# PLATEGA_MERCHANT_ID=
# PLATEGA_SECRET=
# PLATEGA_DAYS_BACK=150
# PLATEGA_AUTO_SYNC=0
# PLATEGA_CRON_TOKEN=

# ============================================
# Финансы: YooKassa
# ============================================
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# YOOKASSA_DAYS_BACK=30
# YOOKASSA_AUTO_SYNC=0
# YOOKASSA_COMMISSIONS={"bank_card":3,"sbp":0.5,"yoo_money":3,"sberbank":3,"tinkoff_bank":3,"mobile":6,"cash":3,"qiwi":3}
# YOOKASSA_CRON_TOKEN=

# ============================================
# Автосинхронизация платежей
# ============================================
# Интервал автосинка (секунды, минимум 30). Реальный интервал: максимум(30, значение).
AUTO_SYNC_INTERVAL=300