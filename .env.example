# ============================================
# HexaVeil CMS — deployment / domains
# ============================================
# Generated by deploy/install.sh; keep this file free of real secrets.
# SITE_DOMAIN     — public website (PHP)
# ADMIN_DOMAIN    — admin SPA (/admin/) + FastAPI (/api/*)
SITE_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=ops@example.com
ADMIN_LOGIN=admin

# Derived URLs (compose.install.yml / Caddy read these)
SITE_URL=https://example.com
CMS_PUBLIC_URL=https://admin.example.com
CORS_ORIGINS=https://admin.example.com,https://example.com

# Host port for the CMS nginx. Use 3000 when host nginx/selfsteal owns 80/443
# (--behind-proxy). Caddy mode ignores this value.
CMS_HTTP_PORT=3000
CMS_BIND_IP=127.0.0.1

# ============================================
# База данных (PostgreSQL) — обязательные
# ============================================
DB_DRIVER=pgsql
DB_HOST=db
DB_PORT=5432
DB_NAME=cms
DB_USER=cms
DB_PASS=change_this_password

# ============================================
# Приложение
# ============================================
APP_DEBUG=true
SITE_NAME=HexaVeil VPN
ADMIN_EMAIL=admin@example.com

# ============================================
# Безопасность (JWT / шифрование)
# ============================================
# Ключ шифрования для секретов (AES-256-CBC, 64 hex-символа).
# Используется PHP (core/Crypto.php) и FastAPI (web/backend) — должны совпадать.
APP_ENCRYPTION_KEY=your_64_hex_char_encryption_key

# JWT secret. Если пусто — используется APP_ENCRYPTION_KEY (поведение PHP).
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL=86400

# ============================================
# API-сервер (FastAPI)
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
# CORS_ORIGINS задаётся в секции "deployment / domains" выше.
# Для локальной разработки можно использовать:
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# ============================================
# Логирование
# ============================================
LOG_DIR=/app/logs
WEB_LOG_LEVEL=INFO
# Часовой пояс процесса (требует tzdata в образе; влияет на время логов).
TZ=Europe/Moscow
# SQL-эхо (BEGIN / INSERT / COMMIT) — выключено, чтобы не засорять логи.
# Включать только для отладки: SQL_ECHO=1
SQL_ECHO=0
# Максимальный размер загружаемого файла (байт)
MAX_UPLOAD_SIZE=67108864

# ============================================
# Конфигурация Bedolaga Bot (интеграция)
# ============================================
# Bedolaga Bot Web API (прокси для /api/bedolaga/*)
# BEDOLAGA_API_URL=http://your-bot-domain.com
# BEDOLAGA_API_TOKEN=your_bot_web_api_token

# ============================================
# Саппорт: Telegram-канал «личка» (фаза 2)
# ============================================
# Канал активен при наличии токена (или флага tg.main.enabled=1 в support_setting).
# SUPPORT_TG_TOKEN=123456:ABC-your-bot-token
# SUPPORT_TG_BOT_NAME=main
# Форум-мост (фаза 2c; Warn: должен быть остановлен Node-бот — один getUpdates consumer на токен)
# SUPPORT_TG_STAFF_GROUP_ID=-1001234567890
# SUPPORT_TG_FORUM=1
# SUPPORT_TG_ARCHIVE_DAYS=7

# ============================================
# База данных бота (read-only — каталог тарифов)
# ============================================
# BOT_DB_HOST=144.31.156.172
# BOT_DB_PORT=5434
# BOT_DB_NAME=remnawave_bot
# BOT_DB_USER=cms_ro
# BOT_DB_PASS=change_this_readonly_password

# ============================================
# Финансы: Platega
# ============================================
# Значения ниже переопределяют настройки из БД (приоритет env > БД).
# PLATEGA_MERCHANT_ID=
# PLATEGA_SECRET=
# PLATEGA_DAYS_BACK=150
# PLATEGA_AUTO_SYNC=0
# PLATEGA_CRON_TOKEN=

# ============================================
# Финансы: YooKassa
# ============================================
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# YOOKASSA_DAYS_BACK=30
# YOOKASSA_AUTO_SYNC=0
# YOOKASSA_COMMISSIONS={"bank_card":3,"sbp":0.5,"yoo_money":3,"sberbank":3,"tinkoff_bank":3,"mobile":6,"cash":3,"qiwi":3}
# YOOKASSA_CRON_TOKEN=

# ============================================
# Автосинхронизация платежей
# ============================================
# Интервал автосинка (секунды, минимум 30). Реальный интервал: максимум(30, значение).
AUTO_SYNC_INTERVAL=300

# ============================================
# Прокси по умолчанию для интеграций
# ============================================
# Можно задать и в админке: Настройки → Интеграции. Значения из админки имеют приоритет.
# Поддерживаются http://, https://, socks5://, socks5h:// (для socks нужен пакет socksio,
# он ставится вместе с httpx[socks]).
# OUTBOUND_PROXY_URL=http://user:pass@proxy.local:3128
# OUTBOUND_PROXY_NO_PROXY=api.telegram.org,.local
# OUTBOUND_PROXY_TEST_URL=https://api.ipify.org

# BEDOLAGA_*, SUPPORT_*, BOT_DB_* — стартовые значения.
# Значения, сохранённые в Настройки → Интеграции, перекрывают их.
