DB_DRIVER=pgsql
DB_HOST=db
DB_PORT=5432
DB_NAME=cms
DB_USER=cms
DB_PASS=change_this_password
APP_ENCRYPTION_KEY=your_64_hex_char_encryption_key
APP_DEBUG=true
SITE_NAME=HexaVeil VPN
ADMIN_EMAIL=admin@example.com

# ── FastAPI backend (Phase 2) ───────────────────────────────────
# JWT secret. If empty, falls back to APP_ENCRYPTION_KEY (PHP behaviour).
# Both PHP (core/JWTAuth.php) and FastAPI (web/backend) must use the same value.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL=86400

# API server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# Uploads / logging paths (inside the api container)
UPLOAD_DIR=/var/www/html/public/uploads
PUBLIC_DIR=/var/www/html/public
LOG_DIR=/app/logs
WEB_LOG_LEVEL=INFO
MAX_UPLOAD_SIZE=67108864
