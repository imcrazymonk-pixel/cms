# ── Fallback host-nginx server block: PUBLIC SITE ──────────────────────────
# Used when Caddy is not available. install.sh renders this template:
#
#   sed 's/__SITE_DOMAIN__/example.com/g' deploy/nginx-host/site.conf.template \
#     | sudo tee /etc/nginx/sites-available/hexaveil-site.conf
#   sudo ln -sf /etc/nginx/sites-available/hexaveil-site.conf /etc/nginx/sites-enabled/
#
# Requirements:
#   * ACME webroot: /var/www/certbot (created by install.sh)
#   * deploy/nginx-host/00-upgrade-map.conf installed into /etc/nginx/conf.d/
#     (defines $connection_upgrade in the http context)
#   * CMS container published on 127.0.0.1:3000 (--behind-proxy mode)

server {
    listen 80;
    listen [::]:80;
    server_name __SITE_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __SITE_DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__SITE_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__SITE_DOMAIN__/privkey.pem;

    client_max_body_size 64M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }
}
