# ── Fallback host-nginx server block: ADMIN / API ──────────────────────────
# Used when Caddy is not available. install.sh renders this template:
#
#   sed 's/__ADMIN_DOMAIN__/admin.example.com/g' deploy/nginx-host/admin.conf.template \
#     | sudo tee /etc/nginx/sites-available/hexaveil-admin.conf
#   sudo ln -sf /etc/nginx/sites-available/hexaveil-admin.conf /etc/nginx/sites-enabled/
#
# The SPA stays at /admin/ (vite base + router basename); the site root
# redirects there. Requirements are the same as site.conf.template:
#   * ACME webroot: /var/www/certbot
#   * deploy/nginx-host/00-upgrade-map.conf in /etc/nginx/conf.d/
#   * CMS container published on 127.0.0.1:3000

server {
    listen 80;
    listen [::]:80;
    server_name __ADMIN_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __ADMIN_DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__ADMIN_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__ADMIN_DOMAIN__/privkey.pem;

    client_max_body_size 64M;

    # SPA lives under /admin/.
    location = / {
        return 302 /admin/;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }
}
