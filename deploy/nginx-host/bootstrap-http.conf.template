# ── TEMPORARY ACME bootstrap config (host-nginx fallback, --behind-proxy) ────
# This is an HTTP-only config rendered by install.sh BEFORE TLS certificates
# exist. It serves the ACME webroot challenge on port 80 and proxies plain HTTP
# to the CMS container, so `certbot certonly --webroot` can validate BOTH
# domains on a fresh host (where the 443 blocks would otherwise fail
# `nginx -t` because /etc/letsencrypt/live/... is still empty).
#
# install.sh swaps it out for site.conf.template + admin.conf.template once
# /etc/letsencrypt/live/<domain>/fullchain.pem exists for BOTH domains.
#
# Requirements (same as the TLS templates):
#   * ACME webroot: /var/www/certbot
#   * deploy/nginx-host/00-upgrade-map.conf in /etc/nginx/conf.d/
#     (defines $connection_upgrade in the http context)
#   * CMS container published on 127.0.0.1:3000 (--behind-proxy mode)

server {
    listen 80;
    listen [::]:80;
    server_name __SITE_DOMAIN__;

    client_max_body_size 64M;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name __ADMIN_DOMAIN__;

    client_max_body_size 64M;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # SPA lives under /admin/.
    location = / {
        return 302 /admin/;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }
}
