# Метка установки (создаётся docker-entrypoint.sh)
/install.lock

# Логи, кеш и временные файлы
/logs/
/storage/

# ОС и редакторы
.DS_Store
Thumbs.db

# Скриншоты и бинарные изображения в корне (только временные)
/*.bmp
/*.png

# Временные текстовые файлы и заметки в корне
/*.txt

# Kilo AI editor — конфигурация агентов, не часть проекта
/.kilo/

# Kilo управляющие файлы в корне
/AGENTS.md
/kilo.json

# Playwright MCP логи
/.playwright-mcp/

# Спеки и дизайн-документы
/docs/superpowers/

# Проект FIN (переделывается в модуль CMS, содержит секреты)
/Fin/

# Эталонный код remnawave-admin (скачан для сверки визуала, не часть проекта)
/remnawave-admin-main/

# Резервные копии финансовых данных (JSON-дампы и исходники FIN) — не в git
/db/backups/

# Кеш Python
__pycache__/
*.pyc

# Установщики и бинарники в корне
/*.exe
/*.pdf

# Временные HTML
/login_out.html

# AI/Kilo конфиги агентов — не часть проекта
/agent/
/.agents/
/.claude/
/skills-lock.json

# React SPA — node_modules игнорируем, а сборку (dist) КОММИТИМ,
# чтобы `git pull` на сервере (без Node) сразу отдавал админку.
/web/frontend/node_modules/
# (web/frontend/dist/ намеренно НЕ в .gitignore)

# Python
/.pytest_cache/
/web/backend/**/__pycache__/

# Docker
/.env
/docker-compose.override.yml
