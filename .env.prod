# ============================================
# Production .env for HexaVeil CMS
# ============================================
# Database
DB_DRIVER=pgsql
DB_HOST=db
DB_PORT=5432
DB_NAME=cms
DB_USER=cms
DB_PASS=сюда_свой_пароль

# App
APP_ENCRYPTION_KEY=сюда_64_hex_символа
APP_DEBUG=false
SITE_NAME=HexaVeil VPN
ADMIN_EMAIL=admin@твой-сайт.ru

# IP адрес для Nginx (заменить на свой новый IP)
CMS_BIND_IP=НОВЫЙ_IP_СЮДА