# ============================================
# Production .env for HexaVeil CMS
# ============================================
# Placeholders only — deploy/install.sh generates real secrets into .env.
# Do NOT commit real credentials.

# Deployment / domains
SITE_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=ops@example.com
ADMIN_LOGIN=admin
SITE_URL=https://example.com
CMS_PUBLIC_URL=https://admin.example.com
CORS_ORIGINS=https://admin.example.com,https://example.com
CMS_HTTP_PORT=3000
CMS_BIND_IP=127.0.0.1

# Database
DB_DRIVER=pgsql
DB_HOST=db
DB_PORT=5432
DB_NAME=cms
DB_USER=cms
DB_PASS=change_this_password

# App
APP_ENCRYPTION_KEY=change_this_64_hex_char_encryption_key
JWT_SECRET=change_this_64_hex_char_jwt_secret
JWT_ALGORITHM=HS256
JWT_TTL=86400
APP_DEBUG=false
SITE_NAME=HexaVeil
ADMIN_EMAIL=ops@example.com

# Runtime
TZ=UTC
LOG_DIR=/app/logs
WEB_LOG_LEVEL=INFO
MAX_UPLOAD_SIZE=67108864
